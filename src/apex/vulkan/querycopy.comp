#version 450
// vkCmdCopyQueryPoolResults: one invocation per query. Pool slots hold a
// 64-bit value then a 32-bit availability word (apex_job.h).
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#include "apex_job.h"
layout(local_size_x = 16) in;
layout(set = 0, binding = 0, std430) readonly buffer Root { uint root[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint w[]; };

uint job(uint i) { return root[APEX_JOB_BASE + i]; }
uint64_t address(uint i) { return uint64_t(job(i)) | (uint64_t(job(i + 1u)) << 32); }

void main()
{
   uint q = gl_GlobalInvocationID.x;
   if (q >= job(APEX_QUERY_COUNT))
      return;
   uint flags = job(APEX_QUERY_FLAGS);
   Words slot = Words(address(APEX_QUERY_SLOT) + uint64_t(q) * APEX_QUERY_STRIDE);
   Words dst = Words(address(APEX_QUERY_DST) + uint64_t(q) * job(APEX_QUERY_DST_STRIDE));
   bool wide = (flags & 1u) != 0u;        // VK_QUERY_RESULT_64_BIT
   bool with_available = (flags & 4u) != 0u;
   bool partial = (flags & 8u) != 0u;
   uint available = slot.w[2];
   uint lo = slot.w[0], hi = slot.w[1];
   if (available != 0u || partial) {
      dst.w[0] = wide || hi == 0u ? lo : 0xffffffffu;
      if (wide)
         dst.w[1] = hi;
   }
   if (with_available) {
      dst.w[wide ? 2u : 1u] = available;
      if (wide)
         dst.w[3] = 0u;
   }
}
