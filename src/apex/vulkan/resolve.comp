#version 450
// Indirect draw resolution: reads one VkDraw[Indexed]IndirectCommand and
// writes the draw's dynamic words, including bin geometry, into its
// parameter block (see apex_draw.h). Draws at or beyond the count buffer's
// value, or exceeding the arena, resolve to zero vertices.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#include "apex_draw.h"
layout(local_size_x = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Root { uint root[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint w[]; };

const uint TRAILER = 8u;
const uint DRAW = TRAILER + APEX_DISPATCH_WORDS;
uint draw(uint i) { return root[DRAW + i]; }
uint64_t address(uint i) { return uint64_t(draw(i)) | (uint64_t(draw(i + 1u)) << 32); }

void main()
{
   Words command = Words(address(APEX_DRAW_INDIRECT));
   bool indexed = draw(APEX_DRAW_INDEX + 2u) != 0u;
   uint vertices = command.w[0], instances = command.w[1], first = command.w[2];
   uint first_instance = command.w[indexed ? 4 : 3];
   uint offset = indexed ? command.w[3] : 0u;
   uint64_t count = address(APEX_DRAW_INDIRECT_COUNT);
   if (count != 0ul && draw(APEX_DRAW_INDIRECT_INDEX) >= Words(count).w[0])
      vertices = 0u;
   uint topology = draw(APEX_DRAW_TOPOLOGY);
   uint prims = topology == 0u ? vertices : topology == 1u ? vertices / 2u :
                topology == 2u ? (vertices >= 2u ? vertices - 1u : 0u) :
                topology == 3u ? vertices / 3u : (vertices >= 3u ? vertices - 2u : 0u);
   uint64_t total = uint64_t(prims) * instances;
   if (uint64_t(vertices) * instances * draw(APEX_DRAW_VERTEX_STRIDE) * 4ul > uint64_t(APEX_ARENA_VERTEX_BYTES) ||
       total * uint64_t(APEX_SUBPRIMS_FOR(topology) * APEX_PRIM_WORDS * 4u) > uint64_t(APEX_ARENA_PRIM_BYTES)) {
      vertices = 0u;
      prims = 0u;
      total = 0ul;
   }
   // Smallest bins, from one 4-pixel tile up, whose lists and counts fit.
   uint chunks = uint((total + uint64_t(APEX_BIN_CHUNK - 1u)) / uint64_t(APEX_BIN_CHUNK));
   uvec4 scissor = uvec4(draw(APEX_DRAW_SCISSOR), draw(APEX_DRAW_SCISSOR + 1u),
                         draw(APEX_DRAW_SCISSOR + 2u), draw(APEX_DRAW_SCISSOR + 3u));
   uint shift = 2u, x0, y0, columns, rows;
   for (;; shift++) {
      x0 = scissor.x >> shift;
      y0 = scissor.y >> shift;
      columns = ((scissor.z + (1u << shift) - 1u) >> shift) - x0;
      rows = ((scissor.w + (1u << shift) - 1u) >> shift) - y0;
      uint64_t bins = uint64_t(columns) * rows;
      if ((bins * total * 4ul <= uint64_t(APEX_ARENA_LIST_BYTES) &&
           bins * chunks * 4ul <= uint64_t(APEX_ARENA_COUNT_BYTES)) || shift == 13u)
         break;
   }
   if (uint64_t(columns) * rows * total * 4ul > uint64_t(APEX_ARENA_LIST_BYTES)) {
      vertices = 0u;
      prims = 0u;
      chunks = 0u;
   }
   Words params = Words(address(APEX_DRAW_PARAMS));
   params.w[APEX_DRAW_VERTEX_COUNT] = vertices;
   params.w[APEX_DRAW_INSTANCE_COUNT] = instances;
   params.w[APEX_DRAW_FIRST_VERTEX] = first;
   params.w[APEX_DRAW_FIRST_INSTANCE] = first_instance;
   params.w[APEX_DRAW_PRIM_COUNT] = prims;
   params.w[APEX_DRAW_INDEX + 3u] = offset;
   params.w[APEX_DRAW_BIN_SHIFT] = shift;
   params.w[APEX_DRAW_BIN_COLUMNS] = columns;
   params.w[APEX_DRAW_BIN_ROWS] = rows;
   params.w[APEX_DRAW_BIN_CHUNKS] = chunks;
   params.w[APEX_DRAW_BIN_X0] = x0;
   params.w[APEX_DRAW_BIN_Y0] = y0;
}
