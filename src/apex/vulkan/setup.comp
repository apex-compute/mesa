#version 450
// Primitive setup: one invocation per input primitive of every instance.
// Assembles source vertices, clips against w >= 2^-126, the x/y guard band,
// z >= 0 and z <= w, snaps to Q16.8 and writes fanned triangles with
// top-left edge equations. Points become gl_PointSize squares whose source
// weights carry gl_PointCoord; lines become width-1 parallelograms offset
// along the minor axis (non-strict lines). See apex_draw.h for record layout.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#include "apex_draw.h"
layout(local_size_x = 64) in;
// The internal program's data root: one zero sentinel row, then the trailer.
layout(set = 0, binding = 0, std430) readonly buffer Root { uint root[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint w[]; };

const uint TRAILER = 8u;
const uint DRAW = TRAILER + 8u;

uint64_t address(uint i) { return uint64_t(root[DRAW + i]) | (uint64_t(root[DRAW + i + 1u]) << 32); }
// Dynamic words of indirect draws live in the resolved parameter block.
uint draw(uint i)
{
   uint64_t params = address(APEX_DRAW_PARAMS);
   return APEX_DRAW_DYNAMIC(i) && params != 0ul ? Words(params).w[i] : root[DRAW + i];
}

// Primitive restart: the index at a draw position equals the all-ones value.
bool restart_at(uint position)
{
   uint bytes = draw(APEX_DRAW_INDEX + 2u);
   uint byte = (position + draw(APEX_DRAW_FIRST_VERTEX)) * bytes;
   uint word = Words(address(APEX_DRAW_INDEX) + uint64_t(byte & ~3u)).w[0];
   uint mask = bytes == 4u ? ~0u : bytes == 2u ? 0xffffu : 0xffu;
   return ((word >> ((byte & 3u) * 8u)) & mask) == mask;
}

vec4 P[10];
vec3 B[10];

// Guard-band scale keeps snapped coordinates within +/-30000 pixels.
float plane_distance(uint plane, vec4 v, vec2 guard)
{
   if (plane == 0u) return v.w - 1.17549435e-38;
   if (plane == 1u) return v.x + guard.x * v.w;
   if (plane == 2u) return guard.x * v.w - v.x;
   if (plane == 3u) return v.y + guard.y * v.w;
   if (plane == 4u) return guard.y * v.w - v.y;
   if (plane == 5u) return v.z;
   return v.w - v.z;
}

void setup(uint g, uint prims)
{
   uint instance = g / prims, p = g - instance * prims;
   uint topology = draw(APEX_DRAW_TOPOLOGY);
   // Strips and fans restart after a restart index: primitives touching one
   // are skipped, and winding parity and the fan center count from the start.
   uint start = 0u;
   bool skip = false;
   if ((topology == 2u || topology >= 4u) && draw(APEX_DRAW_INDEX + 2u) != 0u &&
       draw(APEX_DRAW_RESTART) != 0u) {
      for (uint i = 0u; i < (topology == 2u ? 2u : 3u); i++)
         skip = skip || restart_at(p + i);
      start = p;
      while (!skip && start > 0u && !restart_at(start - 1u))
         start--;
   }
   uint k = p - start;
   uvec3 tuple = topology == 0u ? uvec3(p) :
                 topology == 1u ? uvec3(2u * p, 2u * p + 1u, 2u * p + 1u) :
                 topology == 2u ? uvec3(p, p + 1u, p + 1u) :
                 topology == 5u ? uvec3(p + 1u, p + 2u, start) :
                 topology == 4u ? ((k & 1u) != 0u ? uvec3(p, p + 2u, p + 1u) : uvec3(p, p + 1u, p + 2u)) :
                 uvec3(3u * p, 3u * p + 1u, 3u * p + 2u);
   uvec3 source = tuple + instance * draw(APEX_DRAW_VERTEX_COUNT);
   Words vertices = Words(address(APEX_DRAW_VERTEX_LO));
   uint stride = draw(APEX_DRAW_VERTEX_STRIDE);
   for (uint i = 0u; i < 3u; i++) {
      uint base = source[i] * stride;
      P[i] = uintBitsToFloat(uvec4(vertices.w[base], vertices.w[base + 1u],
                                   vertices.w[base + 2u], vertices.w[base + 3u]));
      B[i] = vec3(i == 0u ? 1.0 : 0.0, i == 1u ? 1.0 : 0.0, i == 2u ? 1.0 : 0.0);
   }
   vec4 viewport = uintBitsToFloat(uvec4(draw(APEX_DRAW_VIEWPORT), draw(APEX_DRAW_VIEWPORT + 1u),
                                         draw(APEX_DRAW_VIEWPORT + 2u), draw(APEX_DRAW_VIEWPORT + 3u)));
   float min_depth = uintBitsToFloat(draw(APEX_DRAW_VIEWPORT + 4u));
   float max_depth = uintBitsToFloat(draw(APEX_DRAW_VIEWPORT + 5u));
   vec2 scale = viewport.zw * 0.5, offset = viewport.xy + scale;
   vec2 guard = vec2(30000.0) / (abs(scale) + abs(offset) + 1.0);

   // Points and lines keep n = 1 or 2 vertices through clipping.
   uint n = skip ? 0u : topology == 0u ? 1u : topology <= 2u ? 2u : 3u;
   if (n == 1u) {
      for (uint plane = 0u; plane < 7u; plane++)
         if (plane_distance(plane, P[0], guard) < 0.0)
            n = 0u;
   } else if (n == 2u) {
      float t0 = 0.0, t1 = 1.0;
      for (uint plane = 0u; plane < 7u; plane++) {
         float d0 = plane_distance(plane, P[0], guard), d1 = plane_distance(plane, P[1], guard);
         if (d0 < 0.0 && d1 < 0.0)
            t0 = 2.0;
         else if (d0 < 0.0)
            t0 = max(t0, d0 / (d0 - d1));
         else if (d1 < 0.0)
            t1 = min(t1, d0 / (d0 - d1));
      }
      if (t0 > t1) {
         n = 0u;
      } else {
         vec4 p0 = P[0], p1 = P[1];
         vec3 b0 = B[0], b1 = B[1];
         P[0] = mix(p0, p1, t0); B[0] = mix(b0, b1, t0);
         P[1] = mix(p0, p1, t1); B[1] = mix(b0, b1, t1);
      }
   }
   for (uint plane = 0u; plane < 7u && n >= 3u; plane++) {
      vec4 Q[10];
      vec3 C[10];
      uint m = 0u;
      for (uint i = 0u; i < n; i++) {
         uint j = i + 1u == n ? 0u : i + 1u;
         float di = plane_distance(plane, P[i], guard);
         float dj = plane_distance(plane, P[j], guard);
         bool in_i = di >= 0.0, in_j = dj >= 0.0;
         if (in_i) {
            Q[m] = P[i]; C[m] = B[i]; m++;
         }
         if (in_i != in_j) {
            float t = di / (di - dj);
            Q[m] = P[i] + t * (P[j] - P[i]);
            C[m] = B[i] + t * (B[j] - B[i]);
            m++;
         }
      }
      n = m < 3u ? 0u : m;
      for (uint i = 0u; i < n; i++) {
         P[i] = Q[i]; B[i] = C[i];
      }
   }

   ivec2 q[10];
   float z[10], inv_w[10];
   for (uint i = 0u; i < n; i++) {
      inv_w[i] = 1.0 / P[i].w;
      vec3 ndc = P[i].xyz * inv_w[i];
      q[i] = ivec2(roundEven((ndc.xy * scale + offset) * 256.0));
      z[i] = ndc.z * (max_depth - min_depth) + min_depth;
   }
   bool polygon = topology >= 3u;
   if (n == 1u) {
      // Corners run clockwise from the upper left; weights (1 - s - t, s, t)
      // of the repeated source vertex give gl_PointCoord (s, t).
      uint size_slot = draw(APEX_DRAW_POINT_SIZE);
      float size = size_slot == ~0u ? 1.0 :
                   uintBitsToFloat(vertices.w[source[0] * stride + size_slot]);
      int h = int(roundEven(clamp(size, 1.0, 64.0) * 128.0));
      for (uint i = 3u; i < 4u; i--) {
         vec2 st = vec2(i == 1u || i == 2u ? 1.0 : 0.0, i >= 2u ? 1.0 : 0.0);
         q[i] = q[0] + ivec2(st * float(2 * h)) - h;
         z[i] = z[0]; inv_w[i] = inv_w[0];
         B[i] = vec3(1.0 - st.x - st.y, st);
      }
      n = 4u;
   } else if (n == 2u) {
      ivec2 d = q[1] - q[0];
      ivec2 minor = abs(d.x) >= abs(d.y) ? ivec2(0, 128) : ivec2(128, 0);
      q[2] = q[1] + minor; z[2] = z[1]; inv_w[2] = inv_w[1]; B[2] = B[1];
      q[3] = q[0] + minor; z[3] = z[0]; inv_w[3] = inv_w[0]; B[3] = B[0];
      q[0] -= minor; q[1] -= minor;
      n = 4u;
   }

   Words records = Words(address(APEX_DRAW_PRIM_LO));
   uint record = g * APEX_SUBPRIMS_FOR(topology) * APEX_PRIM_WORDS;
   uint count = 0u;
   ivec2 union_first = ivec2(0x7fffffff), union_last = ivec2(-0x7fffffff - 1);
   uint cull = draw(APEX_DRAW_CULL);
   bool ccw = draw(APEX_DRAW_FRONT_FACE) == 0u;
   ivec4 scissor = ivec4(draw(APEX_DRAW_SCISSOR), draw(APEX_DRAW_SCISSOR + 1u),
                         draw(APEX_DRAW_SCISSOR + 2u), draw(APEX_DRAW_SCISSOR + 3u));
   for (uint k = 1u; k + 1u < n; k++) {
      uint v[3] = uint[3](0u, k, k + 1u);
      int64_t area = int64_t(q[v[1]].x - q[v[0]].x) * int64_t(q[v[2]].y - q[v[0]].y) -
                     int64_t(q[v[2]].x - q[v[0]].x) * int64_t(q[v[1]].y - q[v[0]].y);
      if (area == 0l)
         continue;
      // Vulkan's signed area is -area/2 in framebuffer coordinates.
      bool front = !polygon || (ccw ? area < 0l : area > 0l);
      if (polygon && (cull & (front ? 1u : 2u)) != 0u)
         continue;
      if (area < 0l) {
         uint t = v[1]; v[1] = v[2]; v[2] = t;
         area = -area;
      }
      ivec2 lo = min(min(q[v[0]], q[v[1]]), q[v[2]]), hi = max(max(q[v[0]], q[v[1]]), q[v[2]]);
      // Pixel centers x*256+128 inside [lo, hi].
      ivec2 first = max((lo - 128 + 255) >> 8, scissor.xy);
      ivec2 last = min(((hi - 128) >> 8) + 1, scissor.zw);
      if (any(greaterThanEqual(first, last)))
         continue;
      uint r = record + count * APEX_PRIM_WORDS;
      for (uint e = 0u; e < 3u; e++) {
         ivec2 a = q[v[(e + 1u) % 3u]], b = q[v[(e + 2u) % 3u]];
         int dx = b.x - a.x, dy = b.y - a.y;
         int64_t c = int64_t(dy) * int64_t(a.x) - int64_t(dx) * int64_t(a.y);
         if (!(dy < 0 || (dy == 0 && dx > 0)))
            c -= 1l;
         records.w[r + APEX_PRIM_EDGE + e * 4u] = uint(a.y - b.y);
         records.w[r + APEX_PRIM_EDGE + e * 4u + 1u] = uint(dx);
         records.w[r + APEX_PRIM_EDGE + e * 4u + 2u] = uint(c);
         records.w[r + APEX_PRIM_EDGE + e * 4u + 3u] = uint(c >> 32);
      }
      union_first = min(union_first, first);
      union_last = max(union_last, last);
      records.w[r + APEX_PRIM_BOX] = uint(first.x);
      records.w[r + APEX_PRIM_BOX + 1u] = uint(first.y);
      records.w[r + APEX_PRIM_BOX + 2u] = uint(last.x);
      records.w[r + APEX_PRIM_BOX + 3u] = uint(last.y);
      records.w[r + APEX_PRIM_RECIPROCAL_AREA] = floatBitsToUint(1.0 / float(area));
      for (uint i = 0u; i < 3u; i++) {
         records.w[r + APEX_PRIM_Z + i] = floatBitsToUint(z[v[i]]);
         records.w[r + APEX_PRIM_INV_W + i] = floatBitsToUint(inv_w[v[i]]);
         for (uint j = 0u; j < 3u; j++)
            records.w[r + APEX_PRIM_WEIGHTS + i * 3u + j] = floatBitsToUint(B[v[i]][j]);
         records.w[r + APEX_PRIM_SOURCE + i] = source[i];
      }
      // Depth bias: m * slope + r * constant with the maximum depth slope m
      // and the minimum resolvable difference r of the depth format.
      float offset = 0.0;
      if (polygon && (draw(APEX_DRAW_DEPTH) & 8u) != 0u) {
         vec2 e1 = vec2(q[v[1]] - q[v[0]]) / 256.0, e2 = vec2(q[v[2]] - q[v[0]]) / 256.0;
         float dz1 = z[v[1]] - z[v[0]], dz2 = z[v[2]] - z[v[0]];
         float det = e1.x * e2.y - e2.x * e1.y;
         float m = max(abs(dz1 * e2.y - dz2 * e1.y), abs(dz2 * e1.x - dz1 * e2.x)) / abs(det);
         uint bits = draw(APEX_DRAW_DEPTH_BIAS + 3u);
         float zmax = max(max(abs(z[v[0]]), abs(z[v[1]])), abs(z[v[2]]));
         int exponent = int((floatBitsToUint(zmax) >> 23) & 0xffu) - 23;
         float resolvable = bits != 0u ? uintBitsToFloat(uint(127 - int(bits)) << 23) :
                                         uintBitsToFloat(uint(max(exponent, 1)) << 23);
         offset = m * uintBitsToFloat(draw(APEX_DRAW_DEPTH_BIAS + 1u)) +
                  resolvable * uintBitsToFloat(draw(APEX_DRAW_DEPTH_BIAS));
         float bias_clamp = uintBitsToFloat(draw(APEX_DRAW_DEPTH_BIAS + 2u));
         offset = bias_clamp > 0.0 ? min(offset, bias_clamp) :
                  bias_clamp < 0.0 ? max(offset, bias_clamp) : offset;
      }
      records.w[r + APEX_PRIM_DEPTH_OFFSET] = floatBitsToUint(offset);
      records.w[r + APEX_PRIM_FLAGS] = front ? 1u : 0u;
      records.w[r + APEX_PRIM_ID] = p;
      count++;
   }
   records.w[record + APEX_PRIM_COUNT] = count;
   bool empty = count == 0u;
   records.w[record + APEX_PRIM_UNION_BOX] = empty ? 0u : uint(union_first.x);
   records.w[record + APEX_PRIM_UNION_BOX + 1u] = empty ? 0u : uint(union_first.y);
   records.w[record + APEX_PRIM_UNION_BOX + 2u] = empty ? 0u : uint(union_last.x);
   records.w[record + APEX_PRIM_UNION_BOX + 3u] = empty ? 0u : uint(union_last.y);
}

// Workgroups base + launch index, stepping by the launch count below the
// job's end: direct jobs run each once, indirect jobs cover the whole draw.
void main()
{
   uint prims = draw(APEX_DRAW_PRIM_COUNT), total = prims * draw(APEX_DRAW_INSTANCE_COUNT);
   uint end = min(root[TRAILER + 4u], (total + 63u) / 64u);
   for (uint w = root[TRAILER] + gl_WorkGroupID.x; w < end; w += root[TRAILER + 3u]) {
      uint g = w * 64u + gl_LocalInvocationID.x;
      if (g < total)
         setup(g, prims);
   }
}
