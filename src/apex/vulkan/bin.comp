#version 450
// Ordered primitive binning: one invocation per (bin, 256-primitive chunk).
// Each walks its chunk in API order and appends input primitives whose union
// box overlaps the bin, so every list segment preserves draw order.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#include "apex_draw.h"
layout(local_size_x = 16) in;
layout(set = 0, binding = 0, std430) readonly buffer Root { uint root[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint w[]; };

const uint TRAILER = 8u;
const uint DRAW = TRAILER + 8u;
uint draw(uint i) { return root[DRAW + i]; }
uint64_t address(uint i) { return uint64_t(draw(i)) | (uint64_t(draw(i + 1u)) << 32); }

void main()
{
   uint columns = draw(APEX_DRAW_BIN_COLUMNS), bins = columns * draw(APEX_DRAW_BIN_ROWS);
   uint padded = (bins + 15u) & ~15u;
   uint item = root[TRAILER] * 16u + gl_GlobalInvocationID.x;
   uint chunk = item / padded, bin = item - chunk * padded;
   uint chunks = draw(APEX_DRAW_BIN_CHUNKS);
   if (bin >= bins || chunk >= chunks)
      return;
   uint total = draw(APEX_DRAW_PRIM_COUNT) * draw(APEX_DRAW_INSTANCE_COUNT);
   uint shift = draw(APEX_DRAW_BIN_SHIFT);
   uint row = bin / columns;
   ivec2 lo = ivec2((bin - row * columns + draw(APEX_DRAW_BIN_X0)) << shift,
                    (row + draw(APEX_DRAW_BIN_Y0)) << shift);
   ivec2 hi = lo + ivec2(1 << shift);
   Words records = Words(address(APEX_DRAW_PRIM_LO));
   Words list = Words(address(APEX_DRAW_BIN_LISTS));
   uint base = bin * total + chunk * APEX_BIN_CHUNK;
   uint end = min(total, chunk * APEX_BIN_CHUNK + APEX_BIN_CHUNK);
   uint n = 0u;
   for (uint p = chunk * APEX_BIN_CHUNK; p < end; p++) {
      uint r = p * APEX_SUBPRIMS * APEX_PRIM_WORDS + APEX_PRIM_UNION_BOX;
      ivec4 box = ivec4(records.w[r], records.w[r + 1u], records.w[r + 2u], records.w[r + 3u]);
      if (all(lessThan(box.xy, hi)) && all(greaterThan(box.zw, lo)))
         list.w[base + n++] = p;
   }
   Words(address(APEX_DRAW_BIN_COUNTS)).w[bin * chunks + chunk] = n;
}
