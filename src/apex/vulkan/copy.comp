#version 450
// Element copy between two surfaces (apex_job.h): one invocation per element
// of a width x height x planes region. Elements of 1 or 2 bytes, and masked
// elements, merge into their destination word with atomics so neighbouring
// lanes never overwrite each other.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#include "apex_job.h"
layout(local_size_x = 16) in;
layout(set = 0, binding = 0, std430) readonly buffer Root { uint root[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint w[]; };

uint job(uint i) { return root[APEX_JOB_BASE + i]; }
#include "apex_surface.glsl"

void main()
{
   uvec3 p = gl_GlobalInvocationID;
   if (p.x >= job(APEX_COPY_EXTENT) || p.y >= job(APEX_COPY_EXTENT + 1u) ||
       p.z >= job(APEX_COPY_EXTENT + 2u))
      return;
   uint bytes = job(APEX_COPY_BYTES);
   uint64_t src = surface_address(APEX_COPY_SRC, p.x, p.y, p.z) + job(APEX_COPY_SRC_OFFSET);
   uint64_t dst = surface_address(APEX_COPY_DST, p.x, p.y, p.z) + job(APEX_COPY_DST_OFFSET);
   uint mask = job(APEX_COPY_MASK);
   if (bytes >= 4u) {
      Words from = Words(src), to = Words(dst);
      for (uint k = 0u; k < bytes / 4u; k++) {
         uint value = from.w[k];
         if (k == 0u && mask != ~0u) {
            atomicAnd(to.w[0], ~mask);
            atomicOr(to.w[0], value & mask);
         } else {
            to.w[k] = value;
         }
      }
      return;
   }
   uint bits = (1u << (bytes * 8u)) - 1u;
   uint value = (Words(src & ~uint64_t(3)).w[0] >> (uint(src & 3u) * 8u)) & bits;
   uint shift = uint(dst & 3u) * 8u;
   Words to = Words(dst & ~uint64_t(3));
   atomicAnd(to.w[0], ~((bits & mask) << shift));
   atomicOr(to.w[0], (value & mask) << shift);
}
