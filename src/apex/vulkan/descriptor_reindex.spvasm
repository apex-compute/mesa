; SPDX-License-Identifier: MIT
; Pass descriptor arrays to a function that indexes them: the callee's access
; chain must reindex the descriptor reference its parameter carries.
OpCapability Shader
OpCapability VariablePointersStorageBuffer
OpCapability StorageBufferArrayDynamicIndexing
OpCapability ShaderNonUniform
OpCapability StorageBufferArrayNonUniformIndexing
OpExtension "SPV_KHR_variable_pointers"
OpExtension "SPV_EXT_descriptor_indexing"
OpMemoryModel Logical GLSL450
OpEntryPoint GLCompute %main "main" %lane_id
OpExecutionMode %main LocalSize 16 1 1
OpDecorate %lane_id BuiltIn LocalInvocationIndex
OpDecorate %words ArrayStride 4
OpMemberDecorate %block 0 Offset 0
OpDecorate %block Block
OpDecorate %sources DescriptorSet 1
OpDecorate %sources Binding 5
OpDecorate %alternate DescriptorSet 1
OpDecorate %alternate Binding 2
OpDecorate %output DescriptorSet 0
OpDecorate %output Binding 3
OpDecorate %indexed NonUniform
OpDecorate %element NonUniform
%void = OpTypeVoid
%fn = OpTypeFunction %void
%uint = OpTypeInt 32 0
%zero = OpConstant %uint 0
%one = OpConstant %uint 1
%two = OpConstant %uint 2
%three = OpConstant %uint 3
%four = OpConstant %uint 4
%fifteen = OpConstant %uint 15
%words = OpTypeRuntimeArray %uint
%block = OpTypeStruct %words
%pair = OpTypeArray %block %two
%ptr_pair = OpTypePointer StorageBuffer %pair
%ptr_block = OpTypePointer StorageBuffer %block
%ptr_word = OpTypePointer StorageBuffer %uint
%ptr_input = OpTypePointer Input %uint
%fn_read = OpTypeFunction %uint %ptr_pair %uint %uint
%sources = OpVariable %ptr_pair StorageBuffer
%alternate = OpVariable %ptr_pair StorageBuffer
%output = OpVariable %ptr_block StorageBuffer
%lane_id = OpVariable %ptr_input Input
%main = OpFunction %void None %fn
%entry = OpLabel
%lane = OpLoad %uint %lane_id
%column = OpBitwiseAnd %uint %lane %one
%opposite = OpBitwiseXor %uint %column %one
%reverse = OpISub %uint %fifteen %lane
%a = OpFunctionCall %uint %read %sources %column %lane
%b = OpFunctionCall %uint %read %alternate %opposite %reverse
%indexed = OpAccessChain %ptr_block %sources %column
%length = OpArrayLength %uint %indexed 0
%sum = OpIAdd %uint %a %b
%base = OpIMul %uint %lane %four
%o1 = OpIAdd %uint %base %one
%o2 = OpIAdd %uint %base %two
%o3 = OpIAdd %uint %base %three
%d0 = OpAccessChain %ptr_word %output %zero %base
%d1 = OpAccessChain %ptr_word %output %zero %o1
%d2 = OpAccessChain %ptr_word %output %zero %o2
%d3 = OpAccessChain %ptr_word %output %zero %o3
OpStore %d0 %a
OpStore %d1 %b
OpStore %d2 %length
OpStore %d3 %sum
OpReturn
OpFunctionEnd
%read = OpFunction %uint None %fn_read
%array = OpFunctionParameter %ptr_pair
%index = OpFunctionParameter %uint
%word = OpFunctionParameter %uint
%read_entry = OpLabel
%element = OpAccessChain %ptr_word %array %index %zero %word
%value = OpLoad %uint %element
OpReturnValue %value
OpFunctionEnd
