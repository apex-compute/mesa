// of three, four bits per partition.
const uint anchors[24] = uint[24](
   0xffffffffu, 0xffffffffu, 0xf882282fu, 0x22882282u, 0xff8286ffu, 0x6ff22282u, 0x22ff8626u, 0xf22fffffu,
