#version 450
// Fills a width x height x planes region of a surface (apex_job.h) with one
// packed texel pattern under a bit mask: one invocation per texel. Texels of
// 1 or 2 bytes, and the partial words of 3- and 6-byte texels, update with
// masked atomics so neighbouring lanes never overwrite each other.
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_buffer_reference : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#include "apex_job.h"
layout(local_size_x = 16) in;
layout(set = 0, binding = 0, std430) readonly buffer Root { uint root[]; };
layout(buffer_reference, std430, buffer_reference_align = 4) buffer Words { uint w[]; };

uint job(uint i) { return root[APEX_JOB_BASE + i]; }
#include "apex_surface.glsl"

void main()
{
   uvec3 p = gl_GlobalInvocationID;
   if (p.x >= job(APEX_CLEAR_EXTENT) || p.y >= job(APEX_CLEAR_EXTENT + 1u) ||
       p.z >= job(APEX_CLEAR_EXTENT + 2u))
      return;
   uint bytes = job(APEX_CLEAR_BYTES);
   uint64_t address = surface_address(APEX_CLEAR_DST, p.x, p.y, p.z);
   if ((bytes & 3u) != 0u && bytes > 2u) {
      // Texel byte t of the pattern lands in byte misalign + t of the
      // covering words.
      uint misalign = uint(address & 3u);
      Words words = Words(address & ~uint64_t(3));
      for (uint k = 0u; k < (misalign + bytes + 3u) / 4u; k++) {
         uint value = 0u, mask = 0u;
         for (uint j = 0u; j < 4u; j++) {
            uint t = k * 4u + j - misalign;
            if (k * 4u + j >= misalign && t < bytes) {
               uint shift = (t & 3u) * 8u;
               value |= ((job(APEX_CLEAR_PATTERN + t / 4u) >> shift) & 0xffu) << (j * 8u);
               mask |= ((job(APEX_CLEAR_MASK + t / 4u) >> shift) & 0xffu) << (j * 8u);
            }
         }
         if (mask == ~0u) {
            words.w[k] = value;
         } else if (mask != 0u) {
            atomicAnd(words.w[k], ~mask);
            atomicOr(words.w[k], value & mask);
         }
      }
   } else if (bytes >= 4u) {
      Words texel = Words(address);
      for (uint k = 0u; k < bytes / 4u; k++) {
         uint mask = job(APEX_CLEAR_MASK + k);
         if (mask == ~0u) {
            texel.w[k] = job(APEX_CLEAR_PATTERN + k);
         } else if (mask != 0u) {
            atomicAnd(texel.w[k], ~mask);
            atomicOr(texel.w[k], job(APEX_CLEAR_PATTERN + k) & mask);
         }
      }
   } else {
      Words aligned = Words(address & ~uint64_t(3));
      uint shift = uint(address & 3u) * 8u;
      uint mask = ((bytes == 1u ? 0xffu : 0xffffu) & job(APEX_CLEAR_MASK)) << shift;
      atomicAnd(aligned.w[0], ~mask);
      atomicOr(aligned.w[0], (job(APEX_CLEAR_PATTERN) << shift) & mask);
   }
}
